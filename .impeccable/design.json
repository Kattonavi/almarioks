      "html": "<button class=\"ds-btn\">Editar</button>",
      "css": ".ds-btn{font-family:'Overpass Variable','Segoe UI',system-ui,sans-serif;font-weight:600;font-size:.875rem;min-height:36px;padding:0 12px;color:#16181d;background:transparent;border:1px solid #868b95;border-radius:4px;cursor:pointer}.ds-btn:hover{background:rgb(22 24 29 / 7%)}.ds-btn:focus-visible{outline:3px solid #16181d;outline-offset:2px}.ds-btn:active{transform:translateY(1px)}"
    },
    {
      "name": "Danger Button",
