    },
    {
      "name": "Group Badge",
      "kind": "chip",
      "refersTo": "group-badge",
      "description": "Distintivo redondo con la inicial del grupo en el color de su línea.",
      "html": "<span class=\"ds-badge\">F</span> <span class=\"ds-badge ds-l2\">T</span> <span class=\"ds-badge ds-l3\">C</span> <span class=\"ds-badge ds-l4\">P</span>",
      "css": ".ds-badge{display:inline-grid;place-items:center;width:26px;height:26px;border-radius:50%;font:800 .8125rem/1 'Overpass Variable',system-ui,sans-serif;color:#16181d;background:#6aa5ff}.ds-l2{background:#f26a1b}.ds-l3{background:#1e9e6a}.ds-l4{background:#f2b705}"
    },
    {
      "name": "Entry Row (selected)",
      "kind": "card",
      "refersTo": "entry-row-selected",
      "description": "Fila de lista seleccionada como panel de señal, con el sello de copiado.",
      "html": "<div class=\"ds-row\"><span class=\"ds-b\">F</span><div><strong>Correo personal</strong><div class=\"ds-sub\">ana@example.com</div></div><span class=\"ds-stamp\"><span class=\"ds-w\">copiado</span> · 14 s</span></div>",
      "css": ".ds-row{font-family:'Overpass Variable','Segoe UI',system-ui,sans-serif;position:relative;display:grid;grid-template-columns:1fr auto;align-items:center;gap:0 12px;padding:8px 24px 8px 62px;min-height:60px;color:#fff;background:#16181d}.ds-b{position:absolute;left:24px;top:50%;transform:translateY(-50%);display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:#6aa5ff;color:#16181d;font:800 .8125rem/1 sans-serif}.ds-sub{font-size:.8125rem;color:#c3cae0}.ds-stamp{font:600 .75rem/1.3 'Overpass Mono Variable',Consolas,monospace;letter-spacing:.04em;padding:2px 7px;color:#fff;border:1.5px solid currentColor;border-radius:3px;transform:rotate(-2deg)}.ds-w{text-transform:uppercase}"
    },
    {
      "name": "Hidden Secret Field Row",
      "kind": "custom",
      "refersTo": "field-row",
      "description": "Etiqueta | valor | acciones; el secreto oculto es una barra de ancho fijo.",
      "html": "<div class=\"ds-field\"><span class=\"ds-dt\">Contraseña</span><span class=\"ds-mask\"></span><button class=\"ds-fbtn\">Copiar</button></div>",
      "css": ".ds-field{font-family:'Overpass Variable','Segoe UI',system-ui,sans-serif;display:grid;grid-template-columns:7.5rem 1fr auto;column-gap:12px;align-items:center;min-height:56px;padding:8px 0;border-bottom:1px solid #ddddd6;color:#16181d}.ds-dt{font-size:.8125rem;font-weight:600;color:#565b66}.ds-mask{display:inline-block;width:156px;height:14px;border-radius:2px;background:repeating-linear-gradient(90deg,#16181d 0 9px,transparent 9px 13px)}.ds-fbtn{font:600 .875rem/1.2 sans-serif;min-height:36px;padding:0 12px;border:1px solid #868b95;border-radius:4px;background:transparent;color:#16181d}"
    },
    {
      "name": "Strength Meter",
      "kind": "custom",
      "refersTo": "notice",
      "description": "Tres tramas (alta, media, baja) siempre junto a su texto.",
      "html": "<p class=\"ds-s\"><span class=\"ds-m ds-ok\"></span> Fortaleza: alta</p><p class=\"ds-s\"><span class=\"ds-m ds-mid\"></span> Fortaleza: media</p><p class=\"ds-s\"><span class=\"ds-m ds-low\"></span> Fortaleza: baja</p>",
      "css": ".ds-s{font:.8125rem sans-serif;display:flex;gap:12px;align-items:center;margin:0 0 6px;color:#16181d}.ds-m{display:inline-block;width:9rem;height:12px;border:1px solid #868b95}.ds-ok{background:repeating-linear-gradient(135deg,#157a52 0 5px,transparent 5px 7px)}.ds-mid{background:repeating-linear-gradient(135deg,#16181d 0 2px,transparent 2px 7px)}.ds-low{background:repeating-linear-gradient(90deg,#d7263d 0 2px,transparent 2px 7px)}"
    },
    {
      "name": "Notice Strip",
      "kind": "custom",
