{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlmarioKS",
  "identifier": "io.github.kattonavi.almarioks",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AlmarioKS",
        "width": 1120,
        "height": 720,
        "minWidth": 480,
        "minHeight": 360,
        "incognito": true,
        "generalAutofillEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true,
      "capabilities": [
        "main-window"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Kattonavi",
    "shortDescription": "Gestor de contraseñas local con bóveda KDBX 4",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwNzFFNjJCMEVBQTE1QTUKUldTbEZhb09LK1p4a0swVFlUNXphMTlXYldJSGlhOXlDSG5iWEhDRi9IUGcvT2xrSzQ0UnVKVXIK",
      "endpoints": [
        "https://github.com/Kattonavi/almarioks/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
