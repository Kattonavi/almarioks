{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Main window: the commands of src/commands/list.rs, the events of the core, the app version and signed updates on user request. No fs, shell, http, dialog, opener or remote access: file dialogs and opening a URL are done from Rust.",
  "windows": [
    "main"
  ],
  "platforms": [
    "windows"
  ],
  "permissions": [
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "allow-vault-status",
    "allow-vault-create",
    "allow-vault-open",
    "allow-vault-lock",
    "allow-vault-close",
    "allow-app-prepare-update",
    "allow-vault-convert",
    "allow-vault-retry-save",
    "allow-vault-save-as",
    "allow-vault-reload",
    "allow-pick-vault-to-open",
    "allow-pick-vault-to-create",
    "allow-pick-key-file",
    "allow-pick-new-key-file",
    "allow-recent-list",
    "allow-recent-remove",
    "allow-password-strength",
    "allow-group-tree",
    "allow-group-create",
    "allow-group-rename",
    "allow-group-move",
    "allow-group-delete-preview",
    "allow-group-delete",
    "allow-recycle-bin-empty",
    "allow-entry-list",
    "allow-entry-get",
    "allow-entry-create",
    "allow-entry-update",
    "allow-entry-move",
    "allow-entry-delete",
    "allow-entry-reveal",
    "allow-entry-copy",
    "allow-entry-open-url",
    "allow-search",
    "allow-generate-password",
    "allow-settings-get",
    "allow-settings-set",
    "allow-activity"
  ]
}
